# Copy to .env and fill in. .env is gitignored — never commit real credentials.
TAPO_USER=your_user
TAPO_PASS=your_pass

# Dual-camera device. Defaults use the SD substreams (stream2/stream7, 720p) to
# avoid Wi-Fi lag from two HD feeds. Switch to HD only if your network can carry
# it:  lens1 stream1 (HD) / stream2 (SD),  lens2 stream6 (HD) / stream7 (SD).
# TAPO_CAM1_PATH=stream1   # HD lens 1 (default stream2 = SD 720p)
# TAPO_CAM2_PATH=stream6   # HD lens 2 (default stream7 = SD 720p)
# TAPO_TRACK_CAM=2         # which lens drives auto-tracking / PTZ (1 or 2)
# TAPO_RTSP_PORT=554
# TAPO_BIND_IP=10.0.0.165  # pin WS-Discovery to your Mac's LAN IP (VPN cases)

# PTZ direction — flip if the camera turns the WRONG way (run calibrate.py):
# TAPO_INVERT_PAN=1
# TAPO_INVERT_TILT=1
